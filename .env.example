# Local development database only. Never expose this compose service publicly.
# Discover the allocated port with: docker compose -p forge-runtime -f deploy/compose/compose.yaml port postgres 5432
FORGE_DATABASE_URL=postgres://forge_admin:forge_dev_only@127.0.0.1:REPLACE_PORT/forge?sslmode=disable
FORGE_LISTEN=127.0.0.1:8097
FORGE_STATE_DIR=./var
